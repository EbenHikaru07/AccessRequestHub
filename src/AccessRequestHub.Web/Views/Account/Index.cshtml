@model List<AccessRequestHub.Web.Domain.User>
@{ ViewData["Title"] = "Pilih user"; }

<h2>Pilih user (simulasi login)</h2>
<p class="text-muted">Hanya untuk demo lokal. Bukan autentikasi production.</p>

@foreach (var u in Model)
{
    <form asp-action="SwitchUser" method="post" class="mb-2">
        <input type="hidden" name="userId" value="@u.Id" />
        <button class="btn btn-outline-primary">@u.DisplayName (@u.Email)</button>
    </form>
}